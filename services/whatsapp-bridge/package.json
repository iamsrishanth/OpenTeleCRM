{
  "name": "@opentelecrm/whatsapp-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone, deploy-anywhere WhatsApp bridge (Baileys). HTTP API: /health, /send, /messages, /typing. Owns its Baileys session + message queue.",
  "scripts": {
    "start": "node dist/bridge.js",
    "dev": "tsx src/bridge.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
