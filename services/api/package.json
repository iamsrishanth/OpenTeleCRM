{
  "name": "@opentelecrm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run --config vitest.contract.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@opentelecrm/contracts": "workspace:*",
    "@opentelecrm/core-domain": "workspace:*",
    "@opentelecrm/db": "workspace:*",
    "@opentelecrm/rule-engine": "workspace:*",
    "@opentelecrm/telephony": "workspace:*",
    "@opentelecrm/whatsapp": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
