[Unit]
Description=OpenTeleCRM Web UI (Next.js on :3007, LAN/Tailnet/tunnel)
Wants=network-online.target opentelecrm-api.service
After=network-online.target opentelecrm-api.service

[Service]
Type=simple
User=sri
Group=sri
WorkingDirectory=/mnt/data/Projects/ByteCodeCRM
Environment=HOME=/home/sri
Environment=PATH=/home/sri/.hermes/profiles/main/home/.nvm/versions/node/v22.23.1/bin:/usr/local/bin:/usr/bin:/bin
# Portable launcher (same script macOS launchd uses): resolves node, boots
# next dev on :3007 (PORT_OVERRIDE override) bound to 0.0.0.0.
ExecStart=/bin/bash /mnt/data/Projects/ByteCodeCRM/infra/launchers/launch-web.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
