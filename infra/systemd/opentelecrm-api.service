[Unit]
Description=OpenTeleCRM REST API (NestJS/Fastify on :3005, prefix /autoupdate/v2)
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service

[Service]
Type=simple
User=sri
Group=sri
WorkingDirectory=/mnt/data/Projects/ByteCodeCRM
Environment=HOME=/home/sri
# Portable launcher (same script macOS launchd uses): sources .env, resolves
# node + tsx dynamically, exports PORT_OVERRIDE=3005, no watch flag.
ExecStart=/bin/bash /mnt/data/Projects/ByteCodeCRM/infra/launchers/launch-api.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
