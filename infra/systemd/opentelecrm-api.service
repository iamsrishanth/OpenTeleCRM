[Unit]
Description=OpenTeleCRM REST API (NestJS/Fastify on :3005, prefix /autoupdate/v2)
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service

[Service]
Type=simple
User=sri
Group=sri
WorkingDirectory=/mnt/data/Projects/ByteCodeCRM
Environment=HOME=/home/sri
# dev.sh sources .env (DATABASE_URL, DEV_JWT_SECRET...) and exports
# PORT_OVERRIDE=3005, then execs tsx on src/main.ts (no watch — single process).
ExecStart=/bin/bash /mnt/data/Projects/ByteCodeCRM/services/api/dev.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
