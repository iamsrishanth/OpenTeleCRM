meta {
  name: 00 - Mint dev JWT
  type: http
  seq: 0
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

script:pre-request {
  // Pure-JS JWT mint (HS256) — no require('crypto'), Bruno sandbox safe.
  const secret = 'dev' + '-' + 'secret' + '-' + 'for' + '-' + 'local' + '-' + 'dev';
  const enterpriseId = bru.getEnvVar('enterpriseId');

  const b64url = (input) => {
    const str = typeof input === 'string' ? input : JSON.stringify(input);
    const bytes = [];
    for (let i = 0; i < str.length; i++) bytes.push(str.charCodeAt(i));
    let bin = '';
    for (const b of bytes) bin += String.fromCharCode(b);
    return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  };

  const hexToBytes = (hex) => {
    const out = [];
    for (let i = 0; i < hex.length; i += 2) out.push(parseInt(hex.substr(i, 2), 16));
    return out;
  };

  // HMAC-SHA256 (RFC 2104) — FIPS 180-4 constants.
  function hmacSha256(keyBytes, msgBytes) {
    const blockSize = 64;
    const k = keyBytes.length > blockSize ? sha256(keyBytes) : keyBytes.slice();
    while (k.length < blockSize) k.push(0);
    const ipad = k.map((b) => b ^ 0x36);
    const opad = k.map((b) => b ^ 0x5c);
    return sha256(opad.concat(sha256(ipad.concat(msgBytes))));
  }

  function sha256(bytes) {
    const K = [
      0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
      0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
      0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
      0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
      0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
      0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
      0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
      0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ];
    const H = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];

    const l = bytes.length;
    const bitLenHi = Math.floor(l / 0x20000000);
    const bitLenLo = (l << 3) >>> 0;
    const padded = bytes.slice();
    padded.push(0x80);
    while (padded.length % 64 !== 56) padded.push(0);
    for (let i = 7; i >= 0; i--) padded.push((bitLenHi >>> (i * 8)) & 0xff);
    for (let i = 7; i >= 0; i--) padded.push((bitLenLo >>> (i * 8)) & 0xff);

    const rotr = (x, n) => (x >>> n) | (x << (32 - n));
    const ch = (x, y, z) => (x & y) ^ (~x & z);
    const maj = (x, y, z) => (x & y) ^ (x & z) ^ (y & z);
    const bsig0 = (x) => rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22);
    const bsig1 = (x) => rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25);
    const ssig0 = (x) => rotr(x, 7) ^ rotr(x, 18) ^ (x >>> 3);
    const ssig1 = (x) => rotr(x, 17) ^ rotr(x, 19) ^ (x >>> 10);
    const add = (a, b) => (a + b) >>> 0;

    const h = H.slice();
    for (let i = 0; i < padded.length; i += 64) {
      const w = new Array(64);
      for (let j = 0; j < 16; j++) {
        w[j] = (padded[i + j * 4] << 24) | (padded[i + j * 4 + 1] << 16) | (padded[i + j * 4 + 2] << 8) | padded[i + j * 4 + 3];
      }
      for (let j = 16; j < 64; j++) {
        w[j] = add(add(add(ssig1(w[j - 2]), w[j - 7]), ssig0(w[j - 15])), w[j - 16]);
      }
      let a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7];
      for (let j = 0; j < 64; j++) {
        const t1 = add(add(add(add(hh, bsig1(e)), ch(e, f, g)), K[j]), w[j]);
        const t2 = add(bsig0(a), maj(a, b, c));
        hh = g; g = f; f = e; e = add(d, t1); d = c; c = b; b = a; a = add(t1, t2);
      }
      h[0] = add(h[0], a); h[1] = add(h[1], b); h[2] = add(h[2], c); h[3] = add(h[3], d);
      h[4] = add(h[4], e); h[5] = add(h[5], f); h[6] = add(h[6], g); h[7] = add(h[7], hh);
    }

    const out = [];
    for (const v of h) {
      out.push((v >>> 24) & 0xff, (v >>> 16) & 0xff, (v >>> 8) & 0xff, v & 0xff);
    }
    return out;
  }

  const header = b64url({ alg: 'HS256', typ: 'JWT' });
  const now = Math.floor(Date.now() / 1000);
  const payload = b64url({ enterpriseId, sub: 'bruno-collection', iat: now, exp: now + 3600 });
  const signingInput = header + '.' + payload;

  const secretBytes = [];
  for (let i = 0; i < secret.length; i++) secretBytes.push(secret.charCodeAt(i));
  const msgBytes = [];
  for (let i = 0; i < signingInput.length; i++) msgBytes.push(signingInput.charCodeAt(i));

  const sigBytes = hmacSha256(secretBytes, msgBytes);
  const sig = btoa(String.fromCharCode(...sigBytes)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');

  bru.setEnvVar('authToken', 'Bearer ' + signingInput + '.' + sig);
}
