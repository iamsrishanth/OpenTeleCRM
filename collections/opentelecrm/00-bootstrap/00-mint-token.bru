meta {
  name: 00 - Mint dev JWT
  type: http
  seq: 0
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

script:pre-request {
  // HMAC-SHA256 via Web Crypto API (Node 22 globalThis.crypto — no require).
    const secret = bru.getEnvVar('devJwtSecret');
  const enterpriseId = bru.getEnvVar('enterpriseId');

  const b64url = (input) => {
    const str = typeof input === 'string' ? input : JSON.stringify(input);
    const bytes = [];
    for (let i = 0; i < str.length; i++) bytes.push(str.charCodeAt(i));
    let bin = '';
    for (const b of bytes) bin += String.fromCharCode(b);
    return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  };

  async function signJWT() {
    const header = b64url({ alg: 'HS256', typ: 'JWT' });
    const now = Math.floor(Date.now() / 1000);
    const payload = b64url({ enterpriseId, sub: 'bruno-collection', iat: now, exp: now + 86400 });
    const signingInput = header + '.' + payload;

    // Web Crypto API — native HMAC-SHA256, no pure-JS implementation bugs.
    const enc = new TextEncoder();
    const key = await crypto.subtle.importKey(
      'raw',
      enc.encode(secret),
      { name: 'HMAC', hash: 'SHA-256' },
      false,
      ['sign'],
    );
    const sigBuf = await crypto.subtle.sign('HMAC', key, enc.encode(signingInput));
    const sigBytes = new Uint8Array(sigBuf);
    let sig = '';
    for (const b of sigBytes) sig += String.fromCharCode(b);
    sig = btoa(sig).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');

    bru.setEnvVar('authToken', 'Bearer ' + signingInput + '.' + sig);
  }

  await signJWT();
}

assert {
  res.status: eq 200
  res.body.status: eq ok
}