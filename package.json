{
  "name": "opentelecrm",
  "version": "0.1.0",
  "private": true,
  "description": "OpenTeleCRM \u2014 1:1 FOSS clone of TeleCRM (telecalling-first sales CRM).",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "biome format --write .",
    "bootstrap": "make bootstrap"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "license": "AGPL-3.0"
}
