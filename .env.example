# TeleCRM-compatible environment configuration.
# Copy to .env and fill in. NEVER commit .env.
#
# --- Core ---
NODE_ENV=development
PORT=3000
API_BASE_PATH=/autoupdate/v2
# Base URL that integrations use to reach this instance
PUBLIC_BASE_URL=http://127.0.0.1:3000

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgres://opentelecrm:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/opentelecrm
DATABASE_SSL=false

# --- Auth (Zitadel) ---
# Zitadel OIDC. In dev, the API accepts a DEV_JWT_SECRET instead.
ZITADEL_ISSUER=
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
# Dev routing base for OAuth callbacks (ignored without Zitadel)
DEV_OAUTH_REDIRECT=http://127.0.0.1:3000/auth/callback
AUTH_JWT_AUDIENCE=opentelecrm

# --- Async API rate limit (per token) ---
ASYNC_RATE_LIMIT_PER_HOUR=18000

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
