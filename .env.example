# TeleCRM-compatible environment configuration.
# Copy to .env and fill in. NEVER commit .env.
#
# --- Core ---
NODE_ENV=development
PORT=3000
API_BASE_PATH=/autoupdate/v2
# Base URL that integrations use to reach this instance (public tunnel origin
# in the operator env; webhook delivery URLs use this).
PUBLIC_BASE_URL=http://127.0.0.1:3005

# --- Service ports (dev.sh overrides) ---
# REST API (services/api dev.sh): PORT_OVERRIDE=3005
# CORS allowlist for the web desk (comma-separated origins). Default covers
# the local Next dev server (3007), the LAN IP, Tailnet (IP + hostname), and
# the Cloudflare tunnel web origin. Add your deployed web origin when the API
# is reached cross-origin (e.g. https://crm.example.com).
CORS_ORIGINS=http://localhost:3007,http://127.0.0.1:3007,http://192.168.29.240:3007,http://100.84.197.35:3007,http://zeus-server.parrot-anaconda.ts.net:3007,https://crm.srishanth.com
# MCP server (services/mcp dev.sh): MCP_PORT=3100 (index.ts default 3101)
# MCP bearer auth: when set, every /mcp request must carry
#   Authorization: Bearer <MCP_BEARER_TOKEN> (timing-safe). Recommended for
#   any deployment where the MCP port is reachable beyond loopback.
# MCP_ENTERPRISE_ID: tenant the MCP server is scoped to. Defaults to the demo
#   enterprise in dev ONLY — production refuses to boot without an explicit
#   value, and without MCP_BEARER_TOKEN unless MCP_ALLOW_UNAUTHENTICATED=true.
# MCP_BEARER_TOKEN=
# MCP_ALLOW_UNAUTHENTICATED=
# Web app API access mode (apps/web): local (default) or tunnel.
#   local  → web API calls hit http://localhost:3005/autoupdate/v2
#   tunnel → web API calls hit ${NEXT_PUBLIC_API_TUNNEL_BASE}/autoupdate/v2
# Default ('auto', when the var is unset): the web app derives the API base
# from window.location at runtime — same host:3005 for localhost/LAN/Tailnet,
# https://api.crm.srishanth.com when served from crm.srishanth.com. `make
# tunnel` writes apps/web/.env.local for explicit tunnel mode; the tunnel base
# is set locally at runtime and is NEVER committed — keep this placeholder
# blank in the repo.
MCP_PORT=3100
NEXT_PUBLIC_API_ACCESS=local
NEXT_PUBLIC_API_TUNNEL_BASE=

# --- Cloudflare tunnel (optional; `make tunnel` uses these) ---
# Set CLOUDFLARE_API_TOKEN + TUNNEL_BASE_URL (and the IDs) in your local .env
# to route web API calls through a Cloudflare tunnel. Values are NEVER
# committed — keep these placeholders blank in the repo.
# TUNNEL_BASE_URL is the bare origin (no path): e.g. https://crm.example.com
# CLOUDFLARE_API_TOKEN needs DNS:Edit + Cloudflare Tunnel:Write scope.
# CLOUDFLARE_TUNNEL_TOKEN (optional) installs the cloudflared connector if set.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_BASE_URL=

# --- Database (PostgreSQL 16) ---
# NEVER commit a real password here — use a placeholder and fill in .env.
DATABASE_URL=postgres://opentelecrm:CHANGE_ME@127.0.0.1:5432/opentelecrm
DATABASE_SSL=false

# --- Auth (Zitadel) ---
# Zitadel OIDC. In dev, the API accepts a DEV_JWT_SECRET instead.
ZITADEL_ISSUER=
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
DEV_JWT_SECRET=
# Dev routing base for OAuth callbacks (ignored without Zitadel)
DEV_OAUTH_REDIRECT=http://127.0.0.1:3000/auth/callback
AUTH_JWT_AUDIENCE=opentelecrm

# --- Demo workspace secret (M0 sync-token exchange) ---
# Set to make seed deterministic; otherwise seed prints a generated one.
DEMO_ENTERPRISE_SECRET=

# --- Async API rate limit (per token) ---
ASYNC_RATE_LIMIT_PER_HOUR=18000

# --- WhatsApp (A2.1 live messaging, operator env) ---
# WHATSAPP_DRIVER=mock|wwebjs|baileys|bridge — 'bridge' rides a standalone
# deploy-anywhere whatsapp-bridge (services/whatsapp-bridge; Baileys 7.x —
# handles business/smba numbers that 6.x rejects with 401). Point
# WHATSAPP_BRIDGE_URL at it (local or remote). 'baileys' pairs a number
# directly in-process (pair once: pnpm --filter @opentelecrm/whatsapp pair
# -- --code <phone>). Keep 'mock' here so the contract suite stays hermetic.
WHATSAPP_DRIVER=mock
WHATSAPP_SESSION_ID=cli
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3098
# Shared secret the API sends to the standalone whatsapp-bridge (Bearer).
# Must match BRIDGE_TOKEN on the bridge side; leave blank if the bridge is
# only reachable on a private interface.
WHATSAPP_BRIDGE_TOKEN=

# --- Telephony (A1.1 live dialing, operator env) ---
# TELEPHONY_DRIVER=mock|asterisk-ari — 'mock' for tests/demos, 'asterisk-ari'
# for the live PBX (native Asterisk with ARI enabled — infra/asterisk).
# The operator service sets TELEPHONY_DRIVER=asterisk-ari + the ARI creds
# (password must match /etc/asterisk/ari.conf); keep 'mock' here for tests.
TELEPHONY_DRIVER=mock
TELEPHONY_ARI_URL=http://127.0.0.1:8088
TELEPHONY_ARI_USER=opentelecrm
TELEPHONY_ARI_PASSWORD=change-me
TELEPHONY_ARI_TRUNK=PJSIP/from-crm
TELEPHONY_ARI_CONTEXT=from-crm
TELEPHONY_ARI_APP=opentelecrm

# --- Automation quota metering (A4.7, D4 divergence fix) ---
# Community mode ships unlimited automations; this is a per-tenant rate
# limiter (runs per minute) that is documented + observable. Per-enterprise
# overrides live in automation_quota (PUT /enterprise/{eid}/automations/quota).
AUTOMATION_RATE_LIMIT_PER_MINUTE=60

# --- Automation outbound HTTP (SSRF guard) ---
# http_request / webhook actions reject private, loopback, link-local, CGNAT
# and reserved targets by default (http(s) schemes + public-only). Two
# explicit escape hatches for operators:
#   AUTOMATION_URL_ALLOWLIST — comma-separated exact origins
#     (scheme://host[:port]) that bypass the private-range rejection,
#     e.g. AUTOMATION_URL_ALLOWLIST=http://10.0.0.5:8080,https://hooks.example.com
#   AUTOMATION_ALLOW_PRIVATE_IPS=true — disable the private-range rejection
#     entirely (self-hosted intranets only; NOT for internet-exposed deploys).
AUTOMATION_URL_ALLOWLIST=
AUTOMATION_ALLOW_PRIVATE_IPS=false

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
